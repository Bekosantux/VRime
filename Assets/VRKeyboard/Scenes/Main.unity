  m_text: "\u300C\u5909\u63DB\u300D\u3092\u62BC\u3057\u305F\u3068\u304D\u3001\u5165\u529B\u4E2D\u306E\u8AAD\u307F
    (\u3072\u3089\u304C\u306A) \u3092 Google \u306B\u9001\u4FE1\u3057\u307E\u3059\u3002\n\u78BA\u5B9A\u6E08\u307F\u306E\u6587\u7AE0\u3084\u9001\u4FE1\u5148
    (VRChat \u306A\u3069) \u306E\u60C5\u5831\u306F\u9001\u4FE1\u3057\u307E\u305B\u3093\u3002\n\u901A\u4FE1\u306F
