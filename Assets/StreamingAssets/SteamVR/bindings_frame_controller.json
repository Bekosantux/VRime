{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "VR日本語キーボードの既定（Steam Frame）",
  "description": "グリップ: 展開・収納（両手で2回続けて同時押し）とパネルの切り替え / スティック: キーの選択 / トリガー: キーの入力",
  "bindings": {
    "/actions/keyboard": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/openclose_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/panel_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/keyboard/in/select_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/keyboard/in/press_left"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/openclose_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/panel_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/keyboard/in/select_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/keyboard/in/press_right"
            }
          }
        }
      ],
      "haptics": [
        {
          "path": "/user/hand/left/output/haptic",
          "output": "/actions/keyboard/out/haptic_left"
        },
        {
          "path": "/user/hand/right/output/haptic",
          "output": "/actions/keyboard/out/haptic_right"
        }
      ]
    }
  }
}
