{
  "action_manifest_version": 0,
  "controller_type": "vive_controller",
  "name": "VR Keyboard spike (vive_controller)",
  "description": "Spike2 default bindings",
  "bindings": {
    "/actions/keyboard": {
      "sources": [
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/keyboard/in/rightstick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/keyboard/in/leftstick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/righttrigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/lefttrigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/rightgrip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/keyboard/in/leftgrip"
            }
          }
        }
      ],
      "haptics": [
        {
          "path": "/user/hand/right/output/haptic",
          "output": "/actions/keyboard/out/hapticright"
        },
        {
          "path": "/user/hand/left/output/haptic",
          "output": "/actions/keyboard/out/hapticleft"
        }
      ]
    }
  }
}